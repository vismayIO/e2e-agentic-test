# Copy karke .env banao (local runs ke liye). CI me yeh sab pipeline secrets/variables se aata hai.

# --- Kise test karna hai (zaroori) ---
APP_URL=https://console.example.com
# APP_NAME=Motadata console                        # report aur notification ka naam (yahi default hai)

# --- Console admin login (zaroori: iske bina admin setup fail hota hai, run red) ---
APP_ADMIN_EMAIL=qa-admin@abc123.mailosaur.net      # admin ka Mailosaur address, isi pe sign-in code aata hai
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=abc123                         # Mailosaur inbox (server) id
# APP_ADMIN_NAME=Test User                         # admin ka display name, jaisa app dikhata hai (yahi default hai)
# MAILOSAUR_BASE_URL=https://mailosaur.com/        # Mailosaur ka koi aur region ho to

# --- Model: inme se EK provider (zaroori) ---
# Azure OpenAI
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI Gateway
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=

# --- IAM module (tests/iam) — optional; na ho to sirf woh tests skip ---
# IAM_SCIM_USER_EMAIL=                             # tenant ka ek directory-managed (SCIM / LDAP) person: source-of-truth warning wala test
# IAM_TEAM=                                        # maujooda team (team → member wala test)
# IAM_TEAM_MEMBER_EMAIL=                           # us team ka ek sadasya

# --- Staging HTTP basic auth (optional) ---
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# --- Notification (optional) ---
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# NOTIFY_ON=always   # ya: problems

# --- Tuning (optional) ---
# NIGHTLY_FAIL_ON=red           # ya: never
# E2E_VIDEO=off                 # failure videos band
# MONKEY_SEED=20261123          # monkey wahi forms dobara chune (seed pichhle run ki report me hota hai)
