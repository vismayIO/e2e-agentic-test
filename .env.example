# Copy this to .env (for local runs). In CI all of it comes from pipeline secrets/variables.

# --- What to test (required) ---
APP_URL=https://console.example.com
# APP_NAME=Motadata console                        # name in the report and notification (this is the default)

# --- Console admin login (required: without it the admin setup fails and the run is red) ---
APP_ADMIN_EMAIL=qa-admin@abc123.mailosaur.net      # the admin's Mailosaur address; the sign-in code arrives here
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=abc123                         # Mailosaur inbox (server) id
# APP_ADMIN_NAME=Test User                         # the admin's display name, as the app shows it (this is the default)
# MAILOSAUR_BASE_URL=https://mailosaur.com/        # for another Mailosaur region

# --- Model: ONE of these providers (required) ---
# Azure OpenAI
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI Gateway
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=

# --- IAM module (tests/iam) — optional; when not set only those tests are skipped ---
# IAM_SCIM_USER_EMAIL=                             # a directory-managed (SCIM / LDAP) person of the tenant: the source-of-truth warning test
# IAM_TEAM=                                        # an existing team (the team → member test)
# IAM_TEAM_MEMBER_EMAIL=                           # a member of that team

# --- Staging HTTP basic auth (optional) ---
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# --- Notification (optional) ---
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# NOTIFY_ON=always   # or: problems

# --- Tuning (optional) ---
# NIGHTLY_FAIL_ON=red           # or: never
# E2E_VIDEO=off                 # no failure videos
# MONKEY_SEED=20261123          # monkey picks the same forms again (the seed is in the previous run's report)
