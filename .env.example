# Copy karke .env banao (local runs ke liye). CI me yeh sab pipeline secrets/variables se aata hai.

# --- Kise test karna hai (zaroori) ---
APP_URL=https://staging.myapp.com
APP_NAME=My App

# --- IAM suite (tests/iam) — na ho to IAM tests skip ---
# APP_URL=https://your-iam-console.example.com
# IAM_ADMIN_EMAIL=qa-admin@abc123.mailosaur.net   # admin ka Mailosaur address, isi pe OTP aata hai
# MAILOSAUR_API_KEY=
# MAILOSAUR_SERVER_ID=abc123                       # Mailosaur inbox (server) id

# --- Model: inme se EK provider ---
# Azure OpenAI
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Anthropic
# ANTHROPIC_API_KEY=
# OpenAI
# OPENAI_API_KEY=

# --- Login wala test user (optional; ho to login flows + signed-in explore chalenge) ---
# E2E_USER_QA_USERNAME=qa-bot@myapp.test
# E2E_USER_QA_PASSWORD=
# LOGIN_PATH=/login

# --- Staging HTTP basic auth (optional) ---
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# --- Notification (optional) ---
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# NOTIFY_ON=always   # ya: problems

# --- Tuning (optional) ---
# NIGHTLY_TAGS=smoke,critical   # sirf in tags wale regression tests
# NIGHTLY_FAIL_ON=red           # ya: never
# E2E_VIDEO=off                 # failure videos band
