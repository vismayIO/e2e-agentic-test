# Copy karke .env banao (local runs ke liye). CI me yeh sab pipeline secrets/variables se aata hai.

# --- Kise test karna hai (zaroori) ---
APP_URL=https://staging.myapp.com
APP_NAME=My App

# --- Console login (sab modules: tests/<module>/) — na ho to signed-in suites skip ---
# APP_URL=https://your-console.example.com
# APP_ADMIN_EMAIL=qa-admin@abc123.mailosaur.net   # admin ka Mailosaur address, isi pe OTP aata hai
# APP_ADMIN_NAME=Test User                         # admin ka display name, jaisa app dikhata hai
# MAILOSAUR_API_KEY=
# MAILOSAUR_SERVER_ID=abc123                       # Mailosaur inbox (server) id

# --- IAM module (tests/iam) ---
# IAM_TENANT_OWNER_EMAIL=                          # set ho to Tenant Owner guard tests chalte hain (kabhi confirm nahi karte)
# IAM_ATTRIBUTES_ENABLED=1                         # admin ko user_attribute.manage mile tab
# IAM_TEAM=                                        # maujooda team (team → member wala test); na ho to skip
# IAM_TEAM_MEMBER_EMAIL=                           # us team ka ek sadasya

# --- Model: inme se EK provider ---
# Azure OpenAI
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT=
# Anthropic
# ANTHROPIC_API_KEY=
# OpenAI
# OPENAI_API_KEY=

# --- Login wala test user (optional; ho to login flows + signed-in explore chalenge) ---
# E2E_USER_QA_USERNAME=qa-bot@myapp.test
# E2E_USER_QA_PASSWORD=
# LOGIN_PATH=/login

# --- Staging HTTP basic auth (optional) ---
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# --- Notification (optional) ---
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# NOTIFY_ON=always   # ya: problems

# --- Tuning (optional) ---
# NIGHTLY_TAGS=smoke,critical   # sirf in tags wale regression tests
# NIGHTLY_FAIL_ON=red           # ya: never
# E2E_VIDEO=off                 # failure videos band
